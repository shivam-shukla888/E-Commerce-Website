# ==========================================
# E-Commerce Website Environment Configuration
# ==========================================
# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Secret for Session Authentication (Change to a random 64-char string in production)
JWT_SECRET=super_secret_jwt_key_for_ecommerce_change_in_production_min_32_chars

# Database File Path (relative to server root or absolute)
DB_PATH=./storage/ecommerce.db

# Client Origin for strict CORS policies
CORS_ORIGIN=http://localhost:5173

# Rate Limiter Window in Minutes & Max Requests
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
